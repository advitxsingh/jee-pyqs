      "question_type": "MCQ",
      "question_text": "If $cosx=|sinx|$ then, the general solution is",
      "question_html": "<div class=\"q-body\"> <div class=\"question q-prose\"><!-- HTML_TAG_START --><p>If  $cosx=|sinx|$  then, the general solution is</p><!-- HTML_TAG_END --></div></div>",
      "options": [
        {
          "label": "A",
          "text": "$x=n\\pi+(-1)^{n}\\frac{\\pi}{4},n \\in Z$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=n\\pi+(-1)^{n}\\frac{\\pi}{4},n \\in Z$ \n<!-- HTML_TAG_END --></div>"
        },
        {
          "label": "B",
          "text": "$x=n\\pi \\pm \\frac{\\pi}{4},n \\in Z$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=n\\pi \\pm \\frac{\\pi}{4},n \\in Z$ \n<!-- HTML_TAG_END --></div>"
        },
        {
          "label": "C",
          "text": "$x=(2n+1)\\pi \\pm \\frac{\\pi}{4},n \\in Z$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=(2n+1)\\pi \\pm \\frac{\\pi}{4},n \\in Z$ \n<!-- HTML_TAG_END --></div>"
        },
        {
          "label": "D",
          "text": "$x=2nx \\pm \\frac{\\pi}{4},n \\in Z$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=2nx \\pm \\frac{\\pi}{4},n \\in Z$ <!-- HTML_TAG_END --></div>"
        }
      ],
      "correct_answer": null,
      "explanation_text": "$\\begin{aligned} & \\text{We have,}|sinx|=cosx \\\\ & \\Rightarrow sin^{2}x=cos^{2}x \\Rightarrow 2cos^{2}x=1 \\\\ & \\Rightarrow cosx=\\frac{1}{\\sqrt{2}}\\text{(since,}cosx\\text{can not be negative)} \\\\ & \\Rightarrow x=2n\\pi \\pm \\frac{\\pi}{4} \\end{aligned}$",
      "explanation_html": "<div class=\"question q-prose\"><!-- HTML_TAG_START --><p> $\\begin{aligned} &amp; \\text{We have,}|sinx|=cosx \\\\ &amp; \\Rightarrow sin^{2}x=cos^{2}x \\Rightarrow 2cos^{2}x=1 \\\\ &amp; \\Rightarrow cosx=\\frac{1}{\\sqrt{2}}\\text{(since,}cosx\\text{can not be negative)} \\\\ &amp; \\Rightarrow x=2n\\pi \\pm \\frac{\\pi}{4} \\end{aligned}$ </p><!-- HTML_TAG_END --></div>",
