      "question_text": "The value at $x=2$ for $\\frac{x^{3}+3x^{2}+3x+1}{x^{4}+4x^{3}+6x^{2}+4x+1}$",
      "question_html": "<div class=\"q-body\"> <div class=\"question q-prose\"><!-- HTML_TAG_START -->The value at  $x=2$  for  $\\frac{x^{3}+3x^{2}+3x+1}{x^{4}+4x^{3}+6x^{2}+4x+1}$ <!-- HTML_TAG_END --></div></div>",
      "options": [
        {
          "label": "A",
          "text": "$3$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $3$ <!-- HTML_TAG_END --></div>"
        },
        {
          "label": "B",
          "text": "$\\frac{25}{61}$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $\\frac{25}{61}$ <!-- HTML_TAG_END --></div>"
        },
        {
          "label": "C",
          "text": "$\\frac{1}{3}$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $\\frac{1}{3}$ <!-- HTML_TAG_END --></div>"
