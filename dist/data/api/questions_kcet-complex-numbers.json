      "exam_date": null,
      "shift": null,
      "question_index": 2,
      "question_type": "MCQ",
      "question_text": "If $(\\frac{1+i}{1-i})^{x}=1$ , then",
      "question_html": "<div class=\"q-body\"> <div class=\"question q-prose\"><!-- HTML_TAG_START --><p>If  $(\\frac{1+i}{1-i})^{x}=1$ , then</p><!-- HTML_TAG_END --></div></div>",
      "options": [
        {
          "label": "A",
          "text": "$x=4n+1,n \\in N$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=4n+1,n \\in N$ \n<!-- HTML_TAG_END --></div>"
        },
        {
          "label": "B",
          "text": "$x=2n+1,n \\in N$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=2n+1,n \\in N$ \n<!-- HTML_TAG_END --></div>"
        },
        {
          "label": "C",
          "text": "$x=2n,n \\in N$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=2n,n \\in N$ \n<!-- HTML_TAG_END --></div>"
        },
        {
          "label": "D",
          "text": "$x=4n,n \\in N$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $x=4n,n \\in N$ <!-- HTML_TAG_END --></div>"
        }
      ],
      "correct_answer": null,
      "explanation_text": "$\\begin{aligned} & \\text{Given,}(\\frac{1+i}{1-i})^{x}=1 \\\\ & \\Rightarrow [\\frac{(1+i)}{1-i)} \\times \\frac{(1+i)}{(1+i)}]^{x}=1 \\\\ & \\Rightarrow [\\frac{1+i^{2}+2i}{1^{2}-i^{2}}]^{x}=1 \\\\ & \\Rightarrow [\\frac{1-1+2i}{1+1}]^{x}=1 \\\\ & \\Rightarrow i^{x}=1 \\\\ & \\Rightarrow i^{x}=1=i^{4n}\\text{where}n \\in N \\\\ & \\therefore x=4n,n \\in N. \\end{aligned}$",
      "explanation_html": "<div class=\"question q-prose\"><!-- HTML_TAG_START --><p> $\\begin{aligned} &amp; \\text{Given,}(\\frac{1+i}{1-i})^{x}=1 \\\\ &amp; \\Rightarrow [\\frac{(1+i)}{1-i)} \\times \\frac{(1+i)}{(1+i)}]^{x}=1 \\\\ &amp; \\Rightarrow [\\frac{1+i^{2}+2i}{1^{2}-i^{2}}]^{x}=1 \\\\ &amp; \\Rightarrow [\\frac{1-1+2i}{1+1}]^{x}=1 \\\\ &amp; \\Rightarrow i^{x}=1 \\\\ &amp; \\Rightarrow i^{x}=1=i^{4n}\\text{where}n \\in N \\\\ &amp; \\therefore x=4n,n \\in N. \\end{aligned}$ </p><!-- HTML_TAG_END --></div>",
      "has_image": false,
