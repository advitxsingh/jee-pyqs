      "question_type": "MCQ",
      "question_text": "The maximum value of $sin(x+\\frac{\\pi}{6})+cos(x+\\frac{\\pi}{6})$ is attained at $x=$",
      "question_html": "<div class=\"q-body\"> <div class=\"question q-prose\"><!-- HTML_TAG_START -->The maximum value of  $sin(x+\\frac{\\pi}{6})+cos(x+\\frac{\\pi}{6})$  is attained at  $x=$ <!-- HTML_TAG_END --></div></div>",
      "options": [
        {
          "label": "A",
          "text": "$\\frac{\\pi}{2}$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $\\frac{\\pi}{2}$ <!-- HTML_TAG_END --></div>"
        },
        {
          "label": "B",
          "text": "$\\frac{\\pi}{4}$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $\\frac{\\pi}{4}$ <!-- HTML_TAG_END --></div>"
        },
        {
          "label": "C",
          "text": "$\\frac{\\pi}{6}$",
          "html": "<div class=\"option-content question\"><!-- HTML_TAG_START --> $\\frac{\\pi}{6}$ <!-- HTML_TAG_END --></div>"
